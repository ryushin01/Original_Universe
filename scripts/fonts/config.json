{
  "outDir": "src/app/styles/fonts",
  "scan": ["src"],
  "dataExtensions": ["json"],
  "extra": "년월일시분초오전후요화수목금토만억조",
  "restOnly": ["src/pages/universe/model/mythic/lore.ts"],
  "fonts": [
    {
      "family": "Freesentation",
      "slug": "freesentation",
      "weights": {
        "200": "scripts/fonts/freesentation/Freesentation-2ExtraLight.woff2",
        "300": "scripts/fonts/freesentation/Freesentation-3Light.woff2",
        "400": "scripts/fonts/freesentation/Freesentation-4Regular.woff2",
        "600": "scripts/fonts/freesentation/Freesentation-6SemiBold.woff2",
        "700": "scripts/fonts/freesentation/Freesentation-7Bold.woff2"
      }
    },
    {
      "family": "Hakgyoansim Byeolbichhaneul",
      "slug": "byeolbichhaneul",
      "weights": {
        "700": "scripts/fonts/byeolbichhaneul/HakgyoansimByeolbichhaneul-B.woff"
      },
      "text": {
        "messages": {
          "file": "src/pages/universe/ui/messages.ts",
          "keys": [
            "page.controls",
            "page.status",
            "mission.wonTitle",
            "mission.lostTitle"
          ]
        },
        "props": {
          "scan": ["src/pages/universe/model"],
          "names": ["name"]
        },
        "extra": "태양"
      },
      "hangulOnly": true,
      "rest": false
    }
  ]
}
